# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session / auth
AUTH_SECRET=

# Database (Neon PostgreSQL)
DATABASE_URL=

# Cache / rate limit (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Object storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public CDN base (pub-….r2.dev or custom domain). Required at build time so
# Next can rewrite /assets/* and /images/* to R2. Do NOT use *.r2.cloudflarestorage.com.
# R2_PUBLIC_URL is accepted as an alias for the same value.
R2_PUBLIC_BASE_URL=
# Same value as R2_PUBLIC_BASE_URL — required for client Image src and proxy rewrites.
NEXT_PUBLIC_R2_PUBLIC_URL=
# Optional; defaults to https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT=

# Email (Resend adapter)
EMAIL_FROM=
RESEND_API_KEY=

# Dev/test seed only (never commit real passwords)
